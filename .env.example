# --- REQUIRED: where paid calls settle (USDC on Base) ---
# Configured default (set by owner 2026-10-06): his OpenTask payout wallet on Base.
# Override per-environment with X402_PAY_TO if a different receiving wallet is wanted.
X402_PAY_TO=0x097f9685D1e0752bF8B02d61E5Ce9be7eA0FBA7F

# --- Pricing (USDC, dollars as string, e.g. "$0.02") ---
X402_PRICE_USDC=$0.02

# --- Network: Base mainnet (eip155:8453) earns REAL USDC. ---
# Base Sepolia testnet (eip155:84532) is the free end-to-end test path.
X402_NETWORK=eip155:8453

# --- Facilitator: selected automatically from X402_NETWORK ---
# Mainnet needs the Coinbase CDP facilitator + API keys (free at
# https://portal.cdp.coinbase.com). Testnet uses the public x402.org
# facilitator (no keys). Override only if you know what you're doing:
# X402_FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Service ---
X402_SERVICE_NAME=extractr
PORT=8000

# --- Solana rail (optional second payment network; OFF by default) ---
# When enabled, POST /v1/verdict also accepts x402 v2 "exact" payments in
# USDC on Solana mainnet, settled by the same facilitator to his Solana
# wallet (receiving only — the service holds no Solana keys and never signs).
SOLANA_RAIL_ENABLED=false
X402_SOLANA_PAY_TO=J6zMrhY1C4rTuH71dMkuVVirWr5eXCRrUg1SQ7qY7si
X402_SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Optional Solana RPC (public mainnet by default at the SDK level); set to
# have the 402 challenge carry fresh blockhash hints for clients.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
